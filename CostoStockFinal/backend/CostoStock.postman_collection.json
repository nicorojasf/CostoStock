            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuarios}}/api/equipo/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@costostock.cl\",\n  \"password\": \"Admin1234\"\n}"
            }
          },
          "event": [
            {
