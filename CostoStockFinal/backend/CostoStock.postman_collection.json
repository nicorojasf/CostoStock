{
  "info": {
    "name": "CostoStock - Microservicios (EFT)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecuta primero los requests de login: guardan el token en las variables token_cliente, token_proveedor, token_soporte y token_admin."
  },
  "variable": [
    {
      "key": "usuarios",
      "value": "http://localhost:8081"
    },
    {
      "key": "productos",
      "value": "http://localhost:8082"
    },
    {
      "key": "pedidos",
      "value": "http://localhost:8083"
    },
    {
      "key": "token_cliente",
      "value": ""
    },
    {
      "key": "token_cliente_id",
      "value": "1"
    },
    {
      "key": "token_proveedor",
      "value": ""
    },
    {
      "key": "token_proveedor_id",
      "value": "1"
    },
    {
      "key": "token_soporte",
      "value": ""
    },
    {
      "key": "token_admin",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Sesiones (4 roles)",
      "item": [
        {
          "name": "Registrar cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuarios}}/api/clientes/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Benjamín Pérez\",\n  \"email\": \"benja@mail.cl\",\n  \"password\": \"Clave1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.token) pm.collectionVariables.set('token_cliente', b.token);",
                  "if (b.id) pm.collectionVariables.set('token_cliente_id', b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuarios}}/api/clientes/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"benja@mail.cl\",\n  \"password\": \"Clave1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.token) pm.collectionVariables.set('token_cliente', b.token);",
                  "if (b.id) pm.collectionVariables.set('token_cliente_id', b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar proveedor",
