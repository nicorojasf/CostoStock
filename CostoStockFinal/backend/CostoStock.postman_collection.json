                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. ms-usuarios",
      "item": [
        {
          "name": "Listar clientes (soporte)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_soporte}}"
              }
            ],
            "url": "{{usuarios}}/api/clientes"
          }
        },
        {
          "name": "Listar clientes como cliente → 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              }
            ],
            "url": "{{usuarios}}/api/clientes"
          }
        },
        {
          "name": "Obtener mi cuenta",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              }
            ],
            "url": "{{usuarios}}/api/clientes/{{token_cliente_id}}"
          }
        },
        {
          "name": "Editar mi nombre",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              }
            ],
            "url": "{{usuarios}}/api/clientes/{{token_cliente_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Benja Pérez\"\n}"
            }
          }
        },
        {
          "name": "Editar proveedor",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_proveedor}}"
              }
            ],
            "url": "{{usuarios}}/api/proveedores/{{token_proveedor_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tienda Nico Spa\",\n  \"telefono\": \"+56987654321\"\n}"
            }
          }
        },
        {
          "name": "Listar equipo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_soporte}}"
              }
            ],
            "url": "{{usuarios}}/api/equipo"
          }
        },
        {
          "name": "Crear soporte (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{usuarios}}/api/equipo",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Soporte Dos\",\n  \"email\": \"soporte2@costostock.cl\",\n  \"password\": \"Soporte1234\",\n  \"rol\": \"SOPORTE\"\n}"
            }
          }
        },
        {
          "name": "Eliminar cliente (soporte) → 403",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_soporte}}"
              }
            ],
            "url": "{{usuarios}}/api/clientes/{{token_cliente_id}}"
          }
        }
      ]
    },
    {
      "name": "3. Recuperar contraseña",
      "item": [
        {
          "name": "Solicitar código",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuarios}}/api/recuperacion/solicitar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"benja@mail.cl\",\n  \"tipo\": \"CLIENTE\"\n}"
            }
          }
        },
        {
          "name": "Restablecer (código de la consola de ms-usuarios)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuarios}}/api/recuperacion/restablecer",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"benja@mail.cl\",\n  \"tipo\": \"CLIENTE\",\n  \"codigo\": \"123456\",\n  \"nuevaPassword\": \"Nueva1234\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. ms-productos",
      "item": [
        {
          "name": "Catálogo (público)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{productos}}/api/productos?soloDisponibles=true"
          }
        },
        {
          "name": "Publicaciones del proveedor",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{productos}}/api/productos?proveedorId={{token_proveedor_id}}"
          }
        },
        {
          "name": "Crear producto (proveedor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_proveedor}}"
              }
            ],
            "url": "{{productos}}/api/productos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Lámpara de escritorio LED\",\n  \"categoria\": \"Hogar\",\n  \"descripcion\": \"3 niveles de luz, brazo flexible\",\n  \"precio\": 12990,\n  \"stock\": 5,\n  \"comuna\": \"Maipú\",\n  \"condicion\": \"NEW\",\n  \"imagenes\": []\n}"
            }
          }
        },
        {
          "name": "Crear producto sin token → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{productos}}/api/productos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Lámpara\",\n  \"categoria\": \"Hogar\",\n  \"descripcion\": \"x\",\n  \"precio\": 1000,\n  \"stock\": 1,\n  \"comuna\": \"Maipú\"\n}"
            }
          }
        },
        {
          "name": "Editar producto (dueño)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_proveedor}}"
              }
            ],
            "url": "{{productos}}/api/productos/15",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Lámpara LED Pro\",\n  \"categoria\": \"Hogar\",\n  \"descripcion\": \"3 niveles de luz\",\n  \"precio\": 14990,\n  \"stock\": 5,\n  \"comuna\": \"Maipú\",\n  \"condicion\": \"NEW\",\n  \"imagenes\": []\n}"
            }
          }
        },
        {
          "name": "Pausar producto (soporte)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_soporte}}"
              }
            ],
            "url": "{{productos}}/api/productos/15/estado",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"PAUSED\"\n}"
            }
          }
        },
        {
          "name": "Eliminar producto (soporte) → 403",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_soporte}}"
              }
            ],
            "url": "{{productos}}/api/productos/15"
          }
        },
        {
          "name": "Eliminar producto (admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{productos}}/api/productos/15"
          }
        }
      ]
    },
    {
      "name": "5. ms-pedidos",
      "item": [
        {
          "name": "Crear pedido (cliente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              }
            ],
            "url": "{{pedidos}}/api/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{token_cliente_id}}\",\n  \"items\": [\n    {\n      \"productoId\": 1,\n      \"cantidad\": 2\n    },\n    {\n      \"productoId\": 4,\n      \"cantidad\": 1\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Mis pedidos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              }
            ],
            "url": "{{pedidos}}/api/pedidos?clienteId={{token_cliente_id}}"
          }
        },
        {
          "name": "Todos los pedidos (soporte)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_soporte}}"
              }
            ],
            "url": "{{pedidos}}/api/pedidos"
          }
        },
        {
          "name": "Cancelar pedido",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              }
            ],
            "url": "{{pedidos}}/api/pedidos/1/cancelar"
          }
        },
        {
          "name": "Eliminar pedido cancelado (admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{pedidos}}/api/pedidos/1"
          }
        }
      ]
    },
