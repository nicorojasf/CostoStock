              }
            ],
            "url": "{{usuarios}}/api/proveedores/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nico@mail.cl\",\n  \"password\": \"Clave1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
